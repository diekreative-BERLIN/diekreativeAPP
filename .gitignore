# Specifies intentionally untracked files to ignore when using Git
# http://git-scm.com/docs/gitignore

*~
*.sw[mnpcod]
.tmp
*.tmp
*.tmp.*
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
UserInterfaceState.xcuserstate
$RECYCLE.BIN/

*.log
log.txt
npm-debug.log*

/.angular
/.idea
/.ionic
/.sass-cache
/.sourcemaps
/.versions
/.vscode
/coverage
/dist
/node_modules
/platforms
/plugins
/www

# native Capacitor-Projekte (enthalten Build-Artefakte mit kompilierten Schlüsseln)
/android
/ios

# Schlüssel, Kennworte, URLs – nur lokal!
src/environments/environment.ts
src/environments/environment.prod.ts
passwords.txt
.env
.env.*

# Firebase-Konfigurationen
GoogleService-Info.plist
google-services.json
/Info.plist

# Backups / Experimente
*.bak
*.try
*-backup
*-try-video
*.ts_*
*.zip
